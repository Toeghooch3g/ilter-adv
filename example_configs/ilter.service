# =============================================================================
# ILTER  —  systemd service unit
# =============================================================================
#
# Runs the ILTER AI gateway binary from /opt/ilter/ilter, sourcing all boot
# configuration from /opt/ilter/env (a systemd EnvironmentFile, i.e. a plain
# `KEY=value` file — see env.postgres.example / env.redis.example in this
# directory).
#
# Install:
#   1. Install the binary and env file:
#        install -m 0755 ilter /opt/ilter/ilter
#        install -m 0600 env.postgres.example /opt/ilter/env   # pick your backend
#      (edit /opt/ilter/env with your real secrets/admin key first)
#   2. Install this unit:
#        install -m 0644 example_configs/ilter.service /etc/systemd/system/ilter.service
#   3. Enable + start:
#        systemctl daemon-reload
#        systemctl enable --now ilter
#   4. Inspect:
#        systemctl status ilter
#        journalctl -u ilter -f
#
# The gateway refuses to start unless ILTER_ADMIN_API_KEY and at least one
# provider API key are set (both are in /opt/ilter/env). Pick a working
# directory that is writable by the service user (or override
# ILTER_STORAGE_PATH in the env file, e.g. /opt/ilter/data/ilter.db).

[Unit]
Description=ILTER AI gateway (proxy + dashboard + metrics)
Documentation=file:///opt/ilter/README.md
# Ensure the environment file exists before we start.
ConditionPathExists=/opt/ilter/ilter
ConditionPathExists=/opt/ilter/env
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Binary + boot configuration.
ExecStart=/opt/ilter/ilter serve
EnvironmentFile=/opt/ilter/env
WorkingDirectory=/opt/ilter

# Drop privileges — run as a dedicated, unprivileged user. Create with:
#   useradd --system --home /opt/ilter --shell /usr/sbin/nologin ilter
User=ilter
Group=ilter

# Restart on crash, with basic backoff (systemd applies ExpectStopwatchDelay).
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
SuccessExitStatus=0

# -- Hardening ---------------------------------------------------------------
# Minimal /dev, no new privileges, private /tmp, no home, no kernel modules.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RemoveIPC=true
RestrictRealtime=true

# Explicit read/write for the runtime dirs the gateway needs.
ReadWritePaths=/opt/ilter/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Resource limits.
LimitNOFILE=65536
LimitNPROC=4096

# Standard logging to the journal.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ilter

[Install]
WantedBy=multi-user.target
