# =============================================================================
# ILTER  —  Postgres semantic-cache backend  —  example environment
# =============================================================================
#
# Copy this file to your environment file and adjust the secrets.
# It is intended to be referenced as a systemd EnvironmentFile (see
# ilter.service in this directory) or sourced into your shell.
#
# Only REGISTERED boot environment variables are listed here — each one is
# read by the gateway at startup (see internal/config/env.go). Unlisted
# ILTER_* variables are ignored and logged as "unknown environment variable".
#
# Two configuration layers exist:
#   * Boot config (this file) — ILTER_* env vars, read once at startup.
#   * Runtime config           — SQLite runtime_config table, edited via the
#                                dashboard / admin API / `ilter init`,
#                                applies hot without restart.
#
# Provider credentials are boot-time ONLY via ILTER_PROVIDER_<NAME>_API_KEY
# (see the bottom of this file); per-operational settings (routing, guardrails,
# MCP servers, feature flags) live in runtime config, not here.

# ---------------------------------------------------------------------------
# Core / listening
# ---------------------------------------------------------------------------

# Proxy (OpenAI/Anthropic-compatible) listen port.
ILTER_SERVER_PORT=8181

# Embedded dashboard listen port.
ILTER_DASHBOARD_PORT=9191

# Dashboard listen host/IP. Empty (default) binds all interfaces.
ILTER_DASHBOARD_HOST=0.0.0.0

# OpenTelemetry/Prometheus metrics listen address (host:port).
ILTER_METRICS_LISTEN_ADDR=0.0.0.0:9192

# ---------------------------------------------------------------------------
# Storage & logging
# ---------------------------------------------------------------------------

# SQLite database path (app data: providers, runtime config, audit, ...).
ILTER_STORAGE_PATH=/opt/ilter/data/ilter.db

# Log level: debug | info | warn | error.
ILTER_LOG_LEVEL=info

# Admin API key. Also derives the AES-256-GCM key used to encrypt provider
# secrets at rest in SQLite. Must be non-empty for `serve` to start.
ILTER_ADMIN_API_KEY=change-me-admin-key-please-32-chars-min

# ---------------------------------------------------------------------------
# Semantic cache  —  POSTGRES backend
# ---------------------------------------------------------------------------
#
# Select the Postgres backend. Requires the `vector` extension; with
# ILTER_CACHE_PG_REQUIRE_VECTORSCALE=true (default) it also requires
# `vectorscale` (+ `timescaledb_toolkit`). Use the bundled Timescale
# timescale/timescaledb-ha:pg16 image — not Homebrew Postgres.
# See docs/configuration.md "Semantic Cache Backends".

# Backend selection: `redis` (default) | `postgres`.
ILTER_CACHE_TYPE=postgres

# Postgres DSN for the semantic cache backend.
ILTER_CACHE_PG_DSN=postgres://ilter:change-me-password@127.0.0.1:5432/ilter_cache?sslmode=require

# Require the pgvectorscale extension (true) or fall back to plain pgvector HNSW (false).
ILTER_CACHE_PG_REQUIRE_VECTORSCALE=true

# Embedding model in `provider:model` form. Empty falls back to the legacy
# Ollama embedder (768D). The vector dimension is probed at startup and
# persisted, so pick a stable model.
ILTER_CACHE_EMBEDDING_MODEL=openai:text-embedding-3-small

# Optional reranker in `provider:model` form. Empty disables rerank.
ILTER_CACHE_RERANK_MODEL=cohere:rerank-english-v3.0

# Number of KNN candidates pulled before rerank.
ILTER_CACHE_RERANK_TOPK=10

# NOTE: ILTER_REDIS_URL is intentionally NOT set for the Postgres backend —
# rate limiting / PII Redis backends are separate and fail open.

# ---------------------------------------------------------------------------
# Provider API keys  (boot-time override + auto-register)
# ---------------------------------------------------------------------------
# Setting ILTER_PROVIDER_<NAME>_API_KEY is enough to enable that provider —
# no `ilter init` required. The plural form (ILTER_PROVIDER_<NAME>_API_KEYS)
# accepts a comma/newline-separated list for load balancing. Known types:
# openai, anthropic, deepseek, gemini, openrouter, ollama, qwen,
# opencode_go, opencode_zen, kop.

ILTER_PROVIDER_OPENAI_API_KEY=sk-change-me
# ILTER_PROVIDER_ANTHROPIC_API_KEY=sk-ant-change-me
# ILTER_PROVIDER_DEEPSEEK_API_KEY=sk-change-me
# ILTER_PROVIDER_GEMINI_API_KEY=change-me
# ILTER_PROVIDER_OPENROUTER_API_KEY=sk-or-change-me
# ILTER_PROVIDER_QWEN_API_KEY=change-me
# ILTER_PROVIDER_OLLAMA_API_KEY=ollama
